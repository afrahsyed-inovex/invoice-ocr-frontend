# true  -> use bundled mock responses (no backend needed)
# false -> send uploads to the real backends below
VITE_USE_MOCK=true

# Base URLs of the locally running backends (no trailing slash)
VITE_MUNHIM_API_URL=http://localhost:8000
VITE_USMAN_API_URL=http://localhost:8001

# Optional: request timeout in milliseconds (OCR can be slow)
VITE_REQUEST_TIMEOUT_MS=60000
