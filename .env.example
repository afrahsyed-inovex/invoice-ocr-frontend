# Munhim's backend (munhims-backend/poc-munhim), started with:
#   uvicorn --factory invoice_pipeline.api.app:app_from_env --port 8000
VITE_MUNHIM_API_URL=http://localhost:8000

# Usman's backend (usmans-backend/invoice--usman). Both backends default to port 8000,
# so set API_PORT=8001 in Usman's .env (Docker) or start uvicorn with --port 8001.
VITE_USMAN_API_URL=http://localhost:8001

# Sent as the X-API-Key header. Must match one of API_KEYS in Usman's .env
# (its .env.example uses "dev-key"). Leave empty if API_KEYS is empty (auth disabled).
VITE_USMAN_API_KEY=dev-key

# Optional per-request LLM override for Usman's backend: auto | always | off.
# Empty uses the backend's LLM_MODE.
VITE_USMAN_LLM_MODE=

# Request timeout in milliseconds (Usman's gunicorn timeout is 120 s).
VITE_REQUEST_TIMEOUT_MS=120000
